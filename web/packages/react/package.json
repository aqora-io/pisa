  },
  "devDependencies": {
    "@tanstack/react-query": "5.105.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.5",
