{
  "name": "@aqora/pisa-client",
  "version": "1.0.0",
  "description": "A typed client for pisa's HTTP API: Lean checks, proof sessions, snapshots and declaration search",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqora-io/pisa.git",
    "directory": "web/packages/client"
  },
  "homepage": "https://github.com/aqora-io/pisa/tree/main/web/packages/client#readme",
  "keywords": [
    "lean",
    "lean4",
    "theorem-prover",
    "pisa"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
