{
  "name": "pisa-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "dev": "pnpm --filter playground dev",
    "generate": "openapi-typescript ../openapi.json --root-types --root-types-no-schema-prefix -o packages/client/src/openapi.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
