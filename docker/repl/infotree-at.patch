@@ -159,6 +159,14 @@ partial def retainTacticInfo (tree : InfoTree) : List InfoTree :=
 partial def retainOriginal (tree : InfoTree) : List InfoTree :=
   tree.filter Info.isOriginal
 
+/-- Retain only nodes with "original" syntax whose range contains one of `ps`. -/
+partial def retainAt (fileMap : FileMap) (ps : List Position) (tree : InfoTree) : List InfoTree :=
+  tree.filter fun i => i.isOriginal && match i.stx? with
+    | none => false
+    | some stx =>
+      let (start, finish) := fileMap.stxRange stx
+      ps.any fun p => !p.lt start && !finish.lt p
+
 /-- Discard all TacticInfo nodes that are tactic combinators or structuring tactics. -/
 -- There is considerable grey area here: what to do with `classical`?
 partial def retainSubstantive (tree : InfoTree) : List InfoTree :=
